# Copy to .env.local and fill in. Never commit .env.local. Never paste keys into chat.
# Verify with: pnpm env:check

# ── Google Maps Platform (H2/H3) ─────────────────────────────────────────────
# Browser key: restricted to "Maps JavaScript API" only + HTTP referrers
#   http://localhost:3000/*  https://colo-nyc.vercel.app/*  (+ your prod domain later). NOT *.vercel.app.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Map ID (JavaScript, Vector) with your light + dark map styles attached
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Server key: restricted to "Places API (New)" only. Used by scripts + GitHub Actions. Never in client code.
GOOGLE_PLACES_SERVER_KEY=

# ── Supabase production project (H5) ─────────────────────────────────────────
# Project Settings → API (Data API) / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (secret) key. Server actions + scripts only. Never in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Database password you chose when creating the project (used once for `supabase link` / `db push`)
SUPABASE_DB_PASSWORD=

# ── Supabase TEST project (E2E only; never the production project) ──────────
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
SUPABASE_TEST_DB_PASSWORD=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated Google-account emails that get /admin
ADMIN_EMAILS=lexiyuewang@gmail.com
# Any long random string (e.g. `openssl rand -hex 32`); salts hashed IPs for anonymous rate limits
IP_HASH_SALT=

# ── Vercel (H6, M2) ──────────────────────────────────────────────────────────
VERCEL_DEPLOY_HOOK_URL=
